# ESP32-S31 UAC2 bridge - milestone 1 (UAC -> I2S0)
CONFIG_IDF_TARGET="esp32s31"

# Console stays on UART0; secondary USB-Serial/JTAG remains available for COM5 logs.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# 0.153: 8x console bandwidth so tick-level BT events are not dropped on the wire.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# Startup needs a little extra main-task stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 1 kHz tick for millisecond-grade audio control loops.
CONFIG_FREERTOS_HZ=1000

# The S31 module carries 16 MB flash. Previous builds incorrectly used 2 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Test tone is disabled for normal UAC operation.
CONFIG_UAC2_TEST_TONE=n

# A2DP source (BT priority over UAC) + BLE tuning channel (任务书 42):
# dual-mode BTDM (Classic A2DP + BLE GATT tuning), BLE memory stays reserved.
# BLE 双模后镜像 ~2.02 MB ⇒ 自定义分区表（factory 3 MB）；nvs/phy_init 偏移不变。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_BLE_ENABLED=y
# BLE 4.2 与 5.0 不能同时开（Kconfig 明示）；传统广播 API 全平台兼容 ⇒ 选 4.2。
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
# Forked Bluedroid internal decoders. Opus/LHDC-v5 intentionally NOT enabled.
CONFIG_BT_A2DP_AAC_DECODER=y
CONFIG_BT_A2DP_APTX_DECODER=y
CONFIG_BT_A2DP_SWITCH_HOLD_MS=80
CONFIG_BT_A2DP_SWITCH_BACK_MS=100

# DSP v1: core1 processing path. Gain is 0.1 dB units; 0 = bit-perfect pass-through.
CONFIG_DSP_ENABLE=y
CONFIG_DSP_MASTER_GAIN_TENTH_DB=0

# Host protocol (WebUI) on the native USB Serial/JTAG COM port + CPU telemetry.
CONFIG_SERIAL_PROTO_ENABLE=y
CONFIG_SERIAL_PROTO_TRANSPORT_USB_JTAG=y
CONFIG_SERIAL_PROTO_TIMEOUT_MS=15000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Fixed/safe output slot width. Runtime API: i2s_out_set_slot_width(16/24/32).
CONFIG_I2S_OUT_SLOT_BITS=32
# BT PCM ring: 12288 stereo frames = 98304 bytes = 128.0 ms @96k.
# 0.171: the LDAC 96 kHz prebuffer is 100 ms = 76800 B; with 8192 frames
# (65536 B, 85.3 ms @96k) that threshold was unreachable, so the gate never
# opened. Keep the ring above the LDAC 96 kHz prebuffer; 16384 frames leaves
# too little heap for Bluedroid (BT init fails), 12288 is the working point.
CONFIG_BT_PCM_RING_FRAMES=12288
# Bluedroid and UAC pump both live on core0; core1 is reserved for future DSP.
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_0=y
# 0.151 PCM injection (test only): USB audio is also pushed into the BT PCM ring
# so device-side stalls can be reproduced without a phone.
# CONFIG_UAC2_BT_INJECT is not set




# Core0 codec framework: measured defaults, no LDAC by default.
CONFIG_BT_A2DP_SBC_SEP=y
CONFIG_BT_A2DP_APTX_CLASSIC_SEP=y
CONFIG_BT_A2DP_APTX_HD_SEP=y
CONFIG_BT_A2DP_APTX_LL_SEP=y
CONFIG_BT_A2DP_CODEC_GUARD=y
CONFIG_BT_A2DP_CODEC_BUDGET_PCT=80
CONFIG_BT_A2DP_CODEC_BAD_WINDOWS=3
CONFIG_BT_A2DP_CODEC_HEAP_RESERVE=8192
# CONFIG_BT_A2DP_LDAC_DECODER is not set
# CONFIG_BT_A2DP_LDAC_EXPERIMENTAL is not set
# CONFIG_BT_A2DP_LHDCV5_96K_EXPERIMENTAL is not set
# CONFIG_BT_A2DP_LHDCV5_KERNEL_SELFTEST is not set
CONFIG_BT_A2DP_LHDCV5_DECODER=y
CONFIG_BT_A2DP_LC3PLUS_DECODER=y
